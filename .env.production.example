# ==============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE — BARE-METAL VPS
# ==============================================================================
# Skopiuj ten plik na serwerze VPS do .env:
# cp .env.production.example .env
# chmod 600 .env

# --- ŚRODOWISKO I PORTY ---
NODE_ENV=production
PORT=3005
APP_URL=https://gielda.dygdon.xyz

# --- BAZA DANYCH (MariaDB na localhost 127.0.0.1) ---
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://gielda_user:TWOJE_SILNE_HASLO@127.0.0.1:3306/gielda_db"

# --- CACHE & RATE LIMITING (Redis na localhost 127.0.0.1) ---
REDIS_URL="redis://127.0.0.1:6379"

# --- UWIERZYTELNIANIE & BEZPIECZEŃSTWO ---
# Wygeneruj 32-bajtowy losowy ciąg: openssl rand -base64 32
AUTH_SECRET="WYGENERUJ_LOSOWY_CIAG_OPENSSL_RAND_BASE64_32"

# --- WEBAUTHN / PASSKEYS (Wymaga domeny produkcyjnej HTTPS) ---
WEBAUTHN_RP_NAME="Market Intelligence"
WEBAUTHN_RP_ID="twojadomena.pl"
WEBAUTHN_ORIGIN="https://app.twojadomena.pl"

# --- PWA WEB PUSH & VAPID NOTIFICATIONS ---
# Wygeneruj parę kluczy VAPID: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY="TWOJ_PUBLICZNY_KLUCZ_VAPID"
VAPID_PRIVATE_KEY="TWOJ_PRYWATNY_KLUCZ_VAPID"
VAPID_SUBJECT="mailto:admin@twojadomena.pl"

# --- DANE RYNKOWE (MARKET DATA PROVIDER) ---
# Domyślnie 'yahoo', opcjonalnie: 'fmp', 'alpha-vantage', 'polygon'
MARKET_DATA_PROVIDER="yahoo"
FMP_API_KEY=""
ALPHA_VANTAGE_API_KEY=""
POLYGON_API_KEY=""

# --- DOSTAWCY AI (SCORING, TEZY I DZIENNIK PROGNOZ) ---
# Dostępne opcje: 'openai', 'gemini', 'claude'
AI_PROVIDER="gemini"
AI_MODEL="gemini-2.0-flash"
GEMINI_API_KEY="TWOJ_GEMINI_API_KEY"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- WORKERY I HARMONOGRAMY (CZĘSTOTLIWOŚĆ EWALUACJI W MS) ---
# 120000 ms = 2 minuty
ALERT_EVALUATION_INTERVAL_MS=120000
