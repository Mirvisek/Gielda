# ==============================================================================
# MARKET INTELLIGENCE — ŚRODOWISKO I KONFIGURACJA (ENVIRONMENT VARIABLES)
# ==============================================================================
# UWAGA: Nigdy nie commituj pliku .env ani żadnych sekretów do repozytorium Git!
# Skopiuj ten plik jako .env i uzupełnij właściwymi wartościami.

# --- Podstawowe ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# --- Baza Danych (MariaDB / MySQL) ---
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://market_user:market_secure_pass_123@localhost:3306/market_intelligence"

# --- Cache i Kolejki (Redis) ---
# Na serwerze VPS: dostępny tylko z localhost:6379
REDIS_URL="redis://localhost:6379"

# --- Bezpieczeństwo Sesji i Kryptografia ---
# Wygeneruj min. 32-znakowy losowy klucz: openssl rand -hex 32
SESSION_SECRET="replace_with_a_super_secret_at_least_32_chars_random_string"
COOKIE_DOMAIN="localhost"

# --- WebAuthn / Passkeys ---
WEBAUTHN_RP_NAME="Market Intelligence"
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_ORIGIN="http://localhost:3000"

# --- Domyślny Provider AI (OpenAI z adapterem) ---
AI_PROVIDER="openai"
OPENAI_API_KEY="sk-proj-..."
OPENAI_MODEL="gpt-4o-mini"
# Opcjonalne inne modele:
# GEMINI_API_KEY=""
# ANTHROPIC_API_KEY=""

# --- Dostawcy Danych Rynkowych (Market Data Providers) ---
MARKET_DATA_PROVIDER="yahoo"
# Opcjonalne klucze dla alternatywnych dostawców:
FMP_API_KEY=""
POLYGON_API_KEY=""
ALPHA_VANTAGE_API_KEY=""

# --- OAuth (Tylko dla uprzednio autoryzowanych kont przez Admina) ---
# Google OAuth:
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple Sign In:
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Facebook Login:
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# --- Skrypt inicjalizacji pierwszego Administratora ---
INITIAL_ADMIN_EMAIL="admin@example.com"
